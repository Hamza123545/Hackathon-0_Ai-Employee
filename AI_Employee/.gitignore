# Bronze Tier Personal AI Employee - Git Ignore

# ============================================
# SENSITIVE FILES - NEVER COMMIT
# ============================================

# Environment configuration (contains secrets)
.env

# Gmail OAuth credentials and tokens
credentials.json
token.pickle
token.json

# Processed items tracker (internal state)
.processed_ids.json

