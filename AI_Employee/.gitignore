# PYTHON
# ============================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# uv package manager
uv.lock
.python-version

# Distribution / packaging
*.egg-info/
dist/
build/
*.egg

# pytest / testing
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/

