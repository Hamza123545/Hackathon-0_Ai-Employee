# Personal AI Employee - Bronze Tier Configuration
# Copy this file to .env and edit with your values
# DO NOT commit .env to version control

# Required: Path to Obsidian vault (the AI_Employee folder itself)
# Default: current directory (.)
VAULT_PATH=./AI_Employee

# Required: Type of watcher to use ('filesystem' or 'gmail')
# Default: filesystem
WATCHER_TYPE=filesystem

# Optional: Check interval in seconds between watcher checks
# Default: 60
CHECK_INTERVAL=60

# Required for filesystem watcher: Folder to monitor for new files
# Default: ./watch_folder
WATCH_PATH=./watch_folder

# Required for Gmail watcher: Path to OAuth credentials JSON file
# Download from Google Cloud Console after enabling Gmail API
# Default: credentials.json
GMAIL_CREDENTIALS_PATH=credentials.json

# Optional: Development mode - if 'true', log actions without writing files
# Default: false
# Set to 'true' during development/testing to avoid creating files
DRY_RUN=false

# Optional: Logging level - DEBUG, INFO, WARNING, ERROR
# Default: INFO
# Use DEBUG for detailed troubleshooting
LOG_LEVEL=INFO